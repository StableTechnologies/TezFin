{
  "name": "TezFinDeploy",
  "version": "1.0.0",
  "main": "deploy.js",
  "engines": {
    "node": "22.16.0"
  },
  "dependencies": {
    "@taquito/local-forging": "^25.0.0",
    "@taquito/signer": "^25.0.0",
    "@taquito/taquito": "^25.0.0",
    "@taquito/utils": "^25.0.0",
    "glob": "^13.0.6",
    "loglevel": "^1.8.1"
  },
  "devDependencies": {},
  "scripts": {
    "check": "node -e \"require('./util').checkConnection().catch(error => { console.error('[ERROR] ' + error.message); process.exitCode = 1; })\"",
